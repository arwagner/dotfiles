#!/usr/bin/env bash

# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# Opaque, so the bar reads the same over a bright window as over a dark one and
# every foreground colour below has one known background to contrast against.
# blur_radius is gone with the translucency: it only ever blurred what showed
# through.
sketchybar --bar position=top height=40 color=0xff1a1b26

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Adding AeroSpace Workspace Indicators #####
# AeroSpace manages its own workspaces rather than mission control spaces, so
# these are plain items (not "space" components) driven by a custom event that
# .aerospace.toml triggers on every workspace switch.
# https://nikitabobko.github.io/AeroSpace/goodies#show-aerospace-workspaces-in-sketchybar

sketchybar --add event aerospace_workspace_change

workspace=(
  # Item padding sits outside the rounded background, so this is the gap
  # between one workspace pill and the next: 16 either side, 32 in total.
  padding_left=16
  padding_right=16
  icon.padding_left=7
  icon.padding_right=4
  # The focused workspace's pill. Only a little lighter than the bar on
  # purpose: the indicator's text is drawn in the status colours from
  # aerospace.sh, and a brighter pill would eat their contrast. This keeps the
  # worst of them (red, at 4.9:1) above the 4.5:1 readable threshold while
  # still separating the pill from the bar.
  background.color=0xff2f3549
  background.corner_radius=5
  background.height=25
  background.drawing=off
  # The label carries the app icons, which are ligatures only this font
  # renders; the icon keeps the workspace key in the readable text font.
  label.font="sketchybar-app-font:Regular:16.0"
  label.padding_left=0
  label.padding_right=7
  label.drawing=off
  drawing=off
)

for sid in $(aerospace list-workspaces --all)
do
  sketchybar --add item space."$sid" left \
             --set space."$sid" "${workspace[@]}" \
                   icon="$sid" \
                   click_script="aerospace workspace $sid"
done

# A single hidden item refreshes every indicator at once, so switching
# workspaces costs three AeroSpace queries rather than one per workspace.
sketchybar --add item workspaces left \
           --set workspaces drawing=off update_freq=30 script="$PLUGIN_DIR/aerospace.sh" \
           --subscribe workspaces aerospace_workspace_change space_windows_change front_app_switched

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once a
# second and the calendar lookup once every five minutes, since it goes over
# the network. Others respond to events they subscribe to, e.g. battery.sh
# only runs when the machine wakes or the power source changes. More info
# about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
           --set clock update_freq=1 icon=  script="$PLUGIN_DIR/clock.sh" \
           --add item headphones right \
           --set headphones update_freq=30 script="$PLUGIN_DIR/headphones.sh" \
                 click_script="open 'x-apple.systempreferences:com.apple.Sound-Settings.extension'" \
           --subscribe headphones system_woke \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item next_event right \
           --set next_event update_freq=300 script="$PLUGIN_DIR/next_event.sh"

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
