#!/usr/bin/env bash

# Build the Home Assistant VM in UTM from nothing:
#
#   install-homeassistant              # download the image and create the VM
#   install-homeassistant --dry-run    # report what would happen, touch nothing
#
# Home Assistant runs as a virtual machine because Home Assistant OS is what its
# add-on store, its Supervisor and every guide online assume. Docker on macOS
# would drop all three, and would also hide the VM behind Docker's private
# network, where the mDNS broadcasts that discover Wi-Fi devices do not reach.
# A bridged VM gets its own address on the LAN, so discovery just works.
#
# UTM rather than VirtualBox: VirtualBox on Apple Silicon is still a developer
# preview. UTM drives QEMU with the hardware hypervisor, so an aarch64 guest
# runs at native speed.
#
# The VM disk is ~32 GiB and never goes in this repo, or in Dropbox — a running
# guest writes to it continuously, so a sync client would upload it forever and
# could restore a half-written copy over a live one. This script rebuilds the
# disk from a pinned download instead, and the state worth keeping travels as
# Home Assistant's own backup .tar, which is small and written once.
#
# Everything else is here: the pinned version, the exact VM shape, and the
# checksum. Two machines running this script get the same VM.

set -euo pipefail

# Pinned so a rebuild months from now is the same VM, not whatever is current.
# Bump both together; the checksum is of the compressed download.
HAOS_VERSION="18.2"
HAOS_SHA256="2c3e1822a4d83498980708d45573da1b74bc25c0643510bf29937a1bf70b1134"

VM_NAME="Home Assistant"

# Home Assistant OS asks for 2 GiB and 2 vCPUs as a floor. 4 GiB leaves room for
# add-ons, which are the reason for running Home Assistant OS at all.
VM_MEMORY_MIB=4096
VM_CPU_CORES=2

CACHE_DIR="$HOME/Library/Caches/dotfiles-haos"
ARCHIVE="$CACHE_DIR/haos_generic-aarch64-$HAOS_VERSION.qcow2.xz"
IMAGE="$CACHE_DIR/haos_generic-aarch64-$HAOS_VERSION.qcow2"
URL="https://github.com/home-assistant/operating-system/releases/download/$HAOS_VERSION/haos_generic-aarch64-$HAOS_VERSION.qcow2.xz"

dry_run=false
case "${1:-}" in
  -n | --dry-run) dry_run=true ;;
  "") ;;
  *)
    echo "usage: install-homeassistant [--dry-run]" >&2
    exit 64
    ;;
esac

run() {
  if [ "$dry_run" = false ]; then
    "$@"
  fi
}

fail() {
  printf 'install-homeassistant: %s\n' "$1" >&2
  exit 1
}

# --- prerequisites --------------------------------------------------------

[ "$(uname -m)" = "arm64" ] ||
  fail "this builds an aarch64 guest and expects an Apple Silicon host"

[ -d /Applications/UTM.app ] ||
  fail "UTM is not installed. Run: brew bundle --file ~/dotfiles/Brewfile"

command -v xz >/dev/null ||
  fail "xz is missing. Run: brew bundle --file ~/dotfiles/Brewfile"

# Bridged mode attaches the guest to a real host interface, which is what gives
# it its own LAN address. Ask the routing table which interface actually carries
# traffic rather than assuming en0 — that is Wi-Fi on a laptop and often
# Ethernet on a Mac mini.
host_interface="$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')"
[ -n "$host_interface" ] ||
  fail "no default route, so there is no interface to bridge onto"

printf 'host      %s (bridging onto %s)\n' "$(uname -m)" "$host_interface"

# --- the VM may already exist ---------------------------------------------

# UTM's AppleScript interface is the only way to create a VM; utmctl can start
# and stop them but not make one. utmctl list is still the cheapest existence
# check, and it does not need UTM to be frontmost.
if utmctl list 2>/dev/null | grep -qF "$VM_NAME"; then
  printf '  ok        VM "%s" already exists\n' "$VM_NAME"
  printf '\nNothing to do. Delete it in UTM first if you want a clean rebuild.\n'
  exit 0
fi

# --- image ----------------------------------------------------------------

verify() {
  printf '%s  %s\n' "$HAOS_SHA256" "$ARCHIVE" | shasum -a 256 -c --status
}

if [ -f "$ARCHIVE" ] && verify; then
  printf '  ok        image %s already downloaded\n' "$HAOS_VERSION"
else
  if [ -f "$ARCHIVE" ]; then
    printf '  redownload  cached image failed its checksum\n'
    run rm -f -- "$ARCHIVE"
  fi
  printf '  download  %s (~360 MiB)\n' "$(basename -- "$URL")"
  run mkdir -p -- "$CACHE_DIR"
  # A partial download must not be left looking like a good one, so write to a
  # temporary name and only move it into place once the checksum passes.
  if [ "$dry_run" = false ]; then
    curl -fL --progress-bar -o "$ARCHIVE.part" "$URL"
    mv -- "$ARCHIVE.part" "$ARCHIVE"
    verify || fail "downloaded image does not match the pinned checksum"
    printf '  ok        checksum matches\n'
  fi
fi

if [ -f "$IMAGE" ]; then
  printf '  ok        image already unpacked\n'
else
  printf '  unpack    %s\n' "$(basename -- "$IMAGE")"
  # -k keeps the archive, so a rerun after deleting the VM does not redownload.
  run xz -dk -- "$ARCHIVE"
fi

# --- create the VM --------------------------------------------------------

# UTM copies the source image into its own bundle, so the cached copy above stays
# untouched and a second run starts from a clean disk.
#
# uefi:true is required — the aarch64 image boots through EDK2, not a BIOS.
# hypervisor:true is what makes this fast; without it QEMU emulates aarch64 in
# software even on an aarch64 host.
read -r -d '' osa <<APPLESCRIPT || true
tell application "UTM"
  set vm to make new virtual machine with properties {backend:qemu, configuration:{name:"$VM_NAME", architecture:"aarch64", machine:"virt", memory:$VM_MEMORY_MIB, cpu cores:$VM_CPU_CORES, hypervisor:true, uefi:true, drives:{{source:POSIX file "$IMAGE", interface:VirtIO}}, network interfaces:{{mode:bridged, host interface:"$host_interface"}}}}
  return id of vm
end tell
APPLESCRIPT

printf '  create    VM "%s" (%s MiB, %s cores, bridged)\n' \
  "$VM_NAME" "$VM_MEMORY_MIB" "$VM_CPU_CORES"

if [ "$dry_run" = true ]; then
  printf '\nNothing written.\n'
  exit 0
fi

# UTM has to be running to answer AppleScript at all.
open -a UTM
for _ in $(seq 1 30); do
  pgrep -qx UTM && break
  sleep 1
done

# The first osascript against a new app raises the macOS Automation prompt. A
# denial arrives as an error here rather than a hang, so say what it means.
if ! vm_id="$(osascript -e "$osa" 2>&1)"; then
  printf 'install-homeassistant: UTM refused to create the VM:\n%s\n' "$vm_id" >&2
  printf '\nIf that mentions "Not authorized", grant this terminal control of UTM\n' >&2
  printf 'in System Settings > Privacy & Security > Automation, then rerun.\n' >&2
  exit 1
fi

printf '  ok        created (%s)\n' "$vm_id"

cat <<NEXT

Start it:
  utmctl start "$VM_NAME"

Then wait a few minutes on first boot and open:
  http://homeassistant.local:8123

If that name does not resolve, ask the guest for its address:
  utmctl ip-address "$VM_NAME"

Backups are the part worth keeping. In Home Assistant, go to
Settings > System > Backups, and send them somewhere synced — the disk itself
is disposable and this script rebuilds it.
NEXT
