#!/usr/bin/env bash

# Symlink this repo's config files into $HOME:
#
#   install              # link everything, backing up anything in the way
#   install --dry-run    # report what would change and touch nothing
#
# The map below is the source of truth for what this repo installs. It is an
# explicit list rather than "link every top-level file" because the mapping is
# not uniform: .config is linked as a whole directory, claude/ is linked file by
# file into ~/.claude (that directory is mostly runtime state — transcripts,
# caches, plugin state — so it cannot be a symlink itself), and bin/ and
# Brewfile are used in place and never linked at all.
#
# ~/.hammerspoon is file by file for the same reason as ~/.claude: Hammerspoon
# keeps its console history there.
#
# Existing regular files are moved aside rather than overwritten, so a config
# that drifted from the repo copy is preserved and reported instead of lost.

set -euo pipefail

# repo path : path under $HOME
MAP=(
  ".zshrc:.zshrc"
  ".zshenv:.zshenv"
  ".gitconfig:.gitconfig"
  ".aerospace.toml:.aerospace.toml"
  ".config:.config"
  "claude/settings.json:.claude/settings.json"
  "claude/CLAUDE.md:.claude/CLAUDE.md"
  "claude/commands:.claude/commands"
  "hammerspoon/init.lua:.hammerspoon/init.lua"
  "vscode/settings.json:Library/Application Support/Code/User/settings.json"
  "vscode/keybindings.json:Library/Application Support/Code/User/keybindings.json"
)

repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

dry_run=false
case "${1:-}" in
  -n | --dry-run) dry_run=true ;;
  "") ;;
  *)
    echo "usage: install [--dry-run]" >&2
    exit 64
    ;;
esac

# .zshrc puts $HOME/dotfiles/bin on PATH and claude/settings.json invokes the
# fleet scripts by their dotfiles/claude/... path, so those files only resolve
# when the clone is at ~/dotfiles. Linking from anywhere else would appear to
# work and then fail at runtime.
if [ "$repo" != "$HOME/dotfiles" ]; then
  echo "install: this repo expects to live at ~/dotfiles, not $repo" >&2
  echo "install: .zshrc and claude/settings.json refer to that path directly" >&2
  exit 1
fi

changed=0
drifted=()

run() {
  if [ "$dry_run" = false ]; then
    "$@"
  fi
}

for entry in "${MAP[@]}"; do
  src="$repo/${entry%%:*}"
  dst="$HOME/${entry#*:}"
  label="${entry#*:}"

  if [ ! -e "$src" ]; then
    echo "install: missing from repo: ${entry%%:*}" >&2
    exit 1
  fi

  # An existing symlink is replaced outright; there is nothing in it to lose.
  # -n matters here: without it, ln would follow a symlinked directory such as
  # ~/.config and create the new link *inside* it.
  if [ -L "$dst" ]; then
    current="$(cd -- "$(dirname -- "$dst")" && readlink -- "$dst")"
    case "$current" in
      /*) resolved="$current" ;;
      *) resolved="$(dirname -- "$dst")/$current" ;;
    esac
    if [ "$resolved" = "$src" ]; then
      printf '  ok        %s\n' "$label"
      continue
    fi
    printf '  relink    %s (was -> %s)\n' "$label" "$current"
    run ln -sfn -- "$src" "$dst"
    changed=$((changed + 1))
    continue
  fi

  if [ -e "$dst" ]; then
    if [ -f "$dst" ] && [ -f "$src" ] && cmp -s -- "$dst" "$src"; then
      # Same content, so there is nothing worth keeping a copy of.
      printf '  link      %s (replaced identical copy)\n' "$label"
      run ln -sfn -- "$src" "$dst"
      changed=$((changed + 1))
      continue
    fi
    backup="$dst.pre-dotfiles.$(date +%Y%m%d%H%M%S)"
    printf '  BACKUP    %s differs from the repo -> %s\n' "$label" "$(basename -- "$backup")"
    drifted+=("$label")
    run mv -- "$dst" "$backup"
    run ln -sfn -- "$src" "$dst"
    changed=$((changed + 1))
    continue
  fi

  printf '  link      %s\n' "$label"
  run mkdir -p -- "$(dirname -- "$dst")"
  run ln -sfn -- "$src" "$dst"
  changed=$((changed + 1))
done

# MCP servers are user scope, which means ~/.claude.json. That file is not a
# symlink candidate for the same reason ~/.claude is not. Claude Code rewrites it
# constantly with session state: prompt history, the OAuth account, and cached
# feature flags, none of which belongs in a public repo. So the definitions are
# tracked in claude/mcp-servers.json and replayed through the CLI instead.
#
# Claude Code expands a ${VAR} in a server's argv when it starts that server, so
# tokens stay in the Dropbox env file .zshenv sources and reach neither JSON
# file. A server whose ${VAR} is unset fails at connect time, not here.
mcp_src="$repo/claude/mcp-servers.json"

if [ -f "$mcp_src" ] && command -v claude >/dev/null 2>&1; then
  printf '\nMCP servers -> ~/.claude.json (user scope):\n'

  # Emits one "name<TAB>ok|set<TAB>definition" line per tracked server. The repo
  # file is a bare name:definition map. ~/.claude.json nests the same map under
  # mcpServers. This adds and updates only, so untracked servers stay untouched.
  while IFS=$'\t' read -r name state want; do
    if [ "$state" = ok ]; then
      printf '  ok        %s\n' "$name"
      continue
    fi
    printf '  register  %s\n' "$name"
    # add-json refuses to overwrite, so an existing definition is removed first.
    # Both calls are quiet: the loop above already reported what is happening.
    if [ "$dry_run" = false ]; then
      claude mcp remove -s user -- "$name" >/dev/null 2>&1 || true
      claude mcp add-json -s user -- "$name" "$want" >/dev/null
    fi
    changed=$((changed + 1))
  done < <(python3 - "$mcp_src" "$HOME/.claude.json" <<'PY'
import json, os, sys


def servers(path):
    if not os.path.exists(path):
        return {}
    doc = json.load(open(path))
    return doc.get("mcpServers", doc)


tracked = servers(sys.argv[1])
installed = servers(sys.argv[2])

for name, want in tracked.items():
    state = "ok" if installed.get(name) == want else "set"
    print("\t".join([name, state, json.dumps(want, sort_keys=True)]))
PY
  )
fi

# The skills and subagents I write live in the buddy repo, not here. That repo is
# their home and it ships its own installer, so this repo records only that a
# machine needs them wired in. Calling buddy's installer keeps one source of
# truth for the wiring. A second copy of that logic here would drift, and drift
# is invisible in this particular place: a personal skill in ~/.claude/skills
# silently wins over a plugin skill of the same name, so a stale link goes
# unnoticed until the behaviour is wrong.
#
# Dropbox may not have synced on a new machine, so a missing buddy is a note
# rather than a failure. Rerun this script once it lands.
buddy_install="$HOME/Dropbox/andrew/code/buddy/install.sh"

printf '\n'
if [ -x "$buddy_install" ]; then
  if [ "$dry_run" = true ]; then
    "$buddy_install" --dry-run
  else
    "$buddy_install"
  fi
elif [ -e "$buddy_install" ]; then
  printf 'buddy: %s is not executable; skipped\n' "$buddy_install"
else
  printf 'buddy: nothing at %s; skipped\n' "$buddy_install"
  printf 'buddy: Dropbox may not have synced yet. Rerun install once it has.\n'
fi

if [ "$dry_run" = true ]; then
  printf '\n%s change(s) to make in this repo; nothing written.\n' "$changed"
  exit 0
fi

printf '\n%s change(s) made in this repo.\n' "$changed"

if [ ${#drifted[@]} -gt 0 ]; then
  printf '\nThese had their own version, kept as *.pre-dotfiles.*:\n'
  for label in "${drifted[@]}"; do
    printf '  %s\n' "$label"
  done
  printf 'Diff each one and fold anything worth keeping into the repo.\n'
fi

cat <<'NEXT'

Not handled here — the rest of a new machine:
  brew bundle --file ~/dotfiles/Brewfile   install the packages
  tfenv install && tfenv use <version>     terraform, into ~/.local/share/tfenv
  exec zsh                                 pick up .zshenv and .zshrc

Permissions macOS only grants by hand:
  Karabiner-Elements                       approve its driver extension, then
                                           grant Input Monitoring
  Hammerspoon                              grant Accessibility, then enable
                                           "Launch at login" in its preferences
NEXT
