#!/usr/bin/env bash

# Symlink this repo's config files into $HOME:
#
#   install              # link everything, backing up anything in the way
#   install --dry-run    # report what would change and touch nothing
#
# The map below is the source of truth for what this repo installs. It is an
# explicit list rather than "link every top-level file" because the mapping is
# not uniform: .config is linked as a whole directory, claude/ is linked file by
# file into ~/.claude (that directory is mostly runtime state — transcripts,
# caches, plugin state — so it cannot be a symlink itself), and bin/, Brewfile
# and macos/ are used in place and never linked at all.
#
# ~/.hammerspoon is file by file for the same reason as ~/.claude: Hammerspoon
# keeps its console history there.
#
# ~/.gitconfig is the one file this repo deliberately does not symlink; the
# block after the loop explains why.
#
# Existing regular files are moved aside rather than overwritten, so a config
# that drifted from the repo copy is preserved and reported instead of lost.

set -euo pipefail

# repo path : path under $HOME
MAP=(
  ".zshrc:.zshrc"
  ".zshenv:.zshenv"
  ".aerospace.toml:.aerospace.toml"
  ".config:.config"
  "claude/settings.json:.claude/settings.json"
  "claude/CLAUDE.md:.claude/CLAUDE.md"
  "claude/commands:.claude/commands"
  "hammerspoon/init.lua:.hammerspoon/init.lua"
  "launchd/com.andrew.homeassistant.plist:Library/LaunchAgents/com.andrew.homeassistant.plist"
  "vscode/settings.json:Library/Application Support/Code/User/settings.json"
  "vscode/keybindings.json:Library/Application Support/Code/User/keybindings.json"
)

repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

dry_run=false
case "${1:-}" in
  -n | --dry-run) dry_run=true ;;
  "") ;;
  *)
    echo "usage: install [--dry-run]" >&2
    exit 64
    ;;
esac

# .zshrc puts $HOME/dotfiles/bin on PATH and claude/settings.json invokes the
# fleet scripts by their dotfiles/claude/... path, so those files only resolve
# when the clone is at ~/dotfiles. Linking from anywhere else would appear to
# work and then fail at runtime.
if [ "$repo" != "$HOME/dotfiles" ]; then
  echo "install: this repo expects to live at ~/dotfiles, not $repo" >&2
  echo "install: .zshrc and claude/settings.json refer to that path directly" >&2
  exit 1
fi

changed=0
drifted=()

run() {
  if [ "$dry_run" = false ]; then
    "$@"
  fi
}

for entry in "${MAP[@]}"; do
  src="$repo/${entry%%:*}"
  dst="$HOME/${entry#*:}"
  label="${entry#*:}"

  if [ ! -e "$src" ]; then
    echo "install: missing from repo: ${entry%%:*}" >&2
    exit 1
  fi

  # An existing symlink is replaced outright; there is nothing in it to lose.
  # -n matters here: without it, ln would follow a symlinked directory such as
  # ~/.config and create the new link *inside* it.
  if [ -L "$dst" ]; then
    current="$(cd -- "$(dirname -- "$dst")" && readlink -- "$dst")"
    case "$current" in
      /*) resolved="$current" ;;
      *) resolved="$(dirname -- "$dst")/$current" ;;
    esac
    if [ "$resolved" = "$src" ]; then
      printf '  ok        %s\n' "$label"
      continue
    fi
    printf '  relink    %s (was -> %s)\n' "$label" "$current"
    run ln -sfn -- "$src" "$dst"
    changed=$((changed + 1))
    continue
  fi

  if [ -e "$dst" ]; then
    if [ -f "$dst" ] && [ -f "$src" ] && cmp -s -- "$dst" "$src"; then
      # Same content, so there is nothing worth keeping a copy of.
      printf '  link      %s (replaced identical copy)\n' "$label"
      run ln -sfn -- "$src" "$dst"
      changed=$((changed + 1))
      continue
    fi
    backup="$dst.pre-dotfiles.$(date +%Y%m%d%H%M%S)"
    printf '  BACKUP    %s differs from the repo -> %s\n' "$label" "$(basename -- "$backup")"
    drifted+=("$label")
    run mv -- "$dst" "$backup"
    run ln -sfn -- "$src" "$dst"
    changed=$((changed + 1))
    continue
  fi

  printf '  link      %s\n' "$label"
  run mkdir -p -- "$(dirname -- "$dst")"
  run ln -sfn -- "$src" "$dst"
  changed=$((changed + 1))
done

# ~/.gitconfig is a real file that includes the repo copy, rather than a symlink
# to it.
#
# actions/checkout guards the global config by copying ~/.gitconfig into a temp
# HOME and pointing GIT_CONFIG_GLOBAL at the copy, so that the
# `git config --global --add safe.directory <workdir>` it runs lands somewhere
# disposable. But @actions/io's cp recreates a symlink as a symlink instead of
# following it, so while ~/.gitconfig was a link the "copy" pointed straight
# back here and every job appended another safe.directory line to this repo.
# That is where the 290 duplicates removed in ca30de0 came from.
#
# A stub breaks the chain: the runner copies a regular file, its writes stay in
# the temp HOME, and git still reads everything in the repo copy via the
# include. Any other tool that writes to the global config is covered too.
gitconfig_stub() {
  cat <<STUB
# Written by dotfiles/bin/install. Deliberately a real file and not a symlink;
# bin/install says why.
[include]
	path = $repo/.gitconfig
STUB
}

printf '\nGit config -> ~/.gitconfig:\n'
dst="$HOME/.gitconfig"
if [ ! -L "$dst" ] && [ -f "$dst" ] && gitconfig_stub | cmp -s - "$dst"; then
  printf '  ok        .gitconfig\n'
else
  if [ -L "$dst" ]; then
    printf '  rewrite   .gitconfig (was a symlink -> %s)\n' "$(readlink -- "$dst")"
    run rm -- "$dst"
  elif [ -e "$dst" ]; then
    backup="$dst.pre-dotfiles.$(date +%Y%m%d%H%M%S)"
    printf '  BACKUP    .gitconfig is not the include stub -> %s\n' "$(basename -- "$backup")"
    drifted+=(".gitconfig")
    run mv -- "$dst" "$backup"
  else
    printf '  write     .gitconfig\n'
  fi
  if [ "$dry_run" = false ]; then
    gitconfig_stub > "$dst"
  fi
  changed=$((changed + 1))
fi

# The desktop is a flat #1a1b26, the same colour as the sketchybar bar. The menu
# bar is set to auto-hide so sketchybar can have the top of the screen, and
# hammerspoon/init.lua pulls sketchybar out of the way whenever the menu bar
# drops back down, which leaves the menu bar drawn straight onto the desktop. As
# of macOS 26 it has no background of its own and tints its text off whatever is
# behind it, so a flat dark desktop is the whole reason it stays readable.
#
# The image is 512x512 rather than screen-sized because it is one colour: every
# row is identical, so it costs 1.5K instead of 650K and upscales to any display
# without artifacts.
#
# This is applied rather than linked. macOS records the path in a wallpaper store
# of its own that is not worth editing by hand, so the file is read from the repo
# in place and set through the public API. It re-applies on every run, which also
# covers the setting not surviving a reboot.
wallpaper="$repo/macos/wallpaper.png"

printf '\nWallpaper -> every display:\n'
if [ ! -f "$wallpaper" ]; then
  echo "install: missing from repo: macos/wallpaper.png" >&2
  exit 1
elif ! command -v swift >/dev/null 2>&1; then
  printf '  skipped   swift is missing; install the Xcode command line tools\n'
else
  # Prints one word: "ok" if every display already shows this file, "set" if it
  # applied it (or would have, under --dry-run), "none" if there are no displays
  # to talk to, or "fail <reason>".
  state="$(swift - "$wallpaper" "$dry_run" <<'SWIFT'
import AppKit

let url = URL(fileURLWithPath: CommandLine.arguments[1])
let dryRun = CommandLine.arguments[2] == "true"
let screens = NSScreen.screens

// Compared as standardized paths rather than as URLs, so that two spellings of
// the same file do not read as a difference and re-apply on every run.
func alreadySet(_ screen: NSScreen) -> Bool {
    NSWorkspace.shared.desktopImageURL(for: screen)?.standardizedFileURL.path
        == url.standardizedFileURL.path
}

if screens.isEmpty {
    print("none")
} else if screens.allSatisfy(alreadySet) {
    print("ok")
} else if dryRun {
    print("set")
} else {
    // Stretched to fill: one colour cannot distort, and this settles what macOS
    // would otherwise decide about tiling a small square across the desktop.
    let options: [NSWorkspace.DesktopImageOptionKey: Any] = [
        .imageScaling: NSNumber(value: NSImageScaling.scaleAxesIndependently.rawValue),
        .allowClipping: true,
    ]
    do {
        for screen in screens {
            try NSWorkspace.shared.setDesktopImageURL(url, for: screen, options: options)
        }
        print("set")
    } catch {
        print("fail \(error.localizedDescription)")
    }
}
SWIFT
  )"

  case "$state" in
    ok) printf '  ok        macos/wallpaper.png\n' ;;
    set)
      printf '  set       macos/wallpaper.png\n'
      changed=$((changed + 1))
      ;;
    none) printf '  skipped   no displays to set a wallpaper on\n' ;;
    *) printf '  FAILED    macos/wallpaper.png: %s\n' "${state#fail }" ;;
  esac
fi

# Claude Code's /terminal-setup sets one thing in Terminal: Option acts as the
# Meta key, which is what makes Option+Enter insert a newline instead of sending
# the prompt. It writes that into com.apple.Terminal and nowhere this repo
# tracks, so a new machine loses it and the command gets run again by hand.
#
# Applied through `defaults export | ... | defaults import` rather than the
# shorter `defaults write -dict-add`. Every profile lives in one "Window
# Settings" dictionary keyed by profile name, and -dict-add replaces a named
# profile wholesale with the dict it is handed, which would drop the font and
# colours along the way. Export, edit the one key, import puts it back intact.
#
# Terminal.app holds its preferences in memory and writes them back when it
# quits, so a change made from inside a Terminal window can be undone by that
# write. Quit Terminal fully and reopen it; the next run of this script reports
# whether the setting survived.
printf '\nTerminal -> Option as Meta key:\n'

# Prints one line: "ok <profile>" if it is already set, "set <profile>" if it
# applied it (or would have, under --dry-run), or "missing <profile>" if the
# default profile is not in the preferences at all.
terminal_state="$(python3 - "$dry_run" <<'TERM_PY'
import plistlib
import subprocess
import sys

dry_run = sys.argv[1] == "true"

exported = subprocess.run(
    ["defaults", "export", "com.apple.Terminal", "-"],
    capture_output=True,
).stdout
prefs = plistlib.loads(exported) if exported else {}

# Terminal falls back to the profile named Basic when it has never been told
# otherwise, which is the state of a machine this script has not run on yet.
name = prefs.get("Default Window Settings", "Basic")
profile = prefs.get("Window Settings", {}).get(name)

if profile is None:
    print("missing " + name)
elif profile.get("useOptionAsMetaKey"):
    print("ok " + name)
elif dry_run:
    print("set " + name)
else:
    profile["useOptionAsMetaKey"] = True
    subprocess.run(
        ["defaults", "import", "com.apple.Terminal", "-"],
        input=plistlib.dumps(prefs),
        check=True,
    )
    print("set " + name)
TERM_PY
)"

case "$terminal_state" in
  "ok "*) printf '  ok        %s profile\n' "${terminal_state#ok }" ;;
  "set "*)
    printf '  set       %s profile (quit Terminal and reopen it)\n' "${terminal_state#set }"
    changed=$((changed + 1))
    ;;
  *) printf '  skipped   no %s profile in com.apple.Terminal\n' "${terminal_state#missing }" ;;
esac

# MCP servers are user scope, which means ~/.claude.json. That file is not a
# symlink candidate for the same reason ~/.claude is not. Claude Code rewrites it
# constantly with session state: prompt history, the OAuth account, and cached
# feature flags, none of which belongs in a public repo. So the definitions are
# tracked in claude/mcp-servers.json and replayed through the CLI instead.
#
# Claude Code expands a ${VAR} in a server's argv when it starts that server, so
# tokens stay in the Dropbox env file .zshenv sources and reach neither JSON
# file. A server whose ${VAR} is unset fails at connect time, not here.
mcp_src="$repo/claude/mcp-servers.json"

if [ -f "$mcp_src" ] && command -v claude >/dev/null 2>&1; then
  printf '\nMCP servers -> ~/.claude.json (user scope):\n'

  # Emits one "name<TAB>ok|set<TAB>definition" line per tracked server. The repo
  # file is a bare name:definition map. ~/.claude.json nests the same map under
  # mcpServers. This adds and updates only, so untracked servers stay untouched.
  while IFS=$'\t' read -r name state want; do
    if [ "$state" = ok ]; then
      printf '  ok        %s\n' "$name"
      continue
    fi
    printf '  register  %s\n' "$name"
    # add-json refuses to overwrite, so an existing definition is removed first.
    # Both calls are quiet: the loop above already reported what is happening.
    if [ "$dry_run" = false ]; then
      claude mcp remove -s user -- "$name" >/dev/null 2>&1 || true
      claude mcp add-json -s user -- "$name" "$want" >/dev/null
    fi
    changed=$((changed + 1))
  done < <(python3 - "$mcp_src" "$HOME/.claude.json" <<'PY'
import json, os, sys


def servers(path):
    if not os.path.exists(path):
        return {}
    doc = json.load(open(path))
    return doc.get("mcpServers", doc)


tracked = servers(sys.argv[1])
installed = servers(sys.argv[2])

for name, want in tracked.items():
    state = "ok" if installed.get(name) == want else "set"
    print("\t".join([name, state, json.dumps(want, sort_keys=True)]))
PY
  )
fi

# spec-flow is a plugin I work on, so it points at its checkout instead of the
# frozen copy Claude Code unpacked when it installed the plugin. An edit in the
# checkout is then live on the next start, with no publish-and-reinstall round
# trip.
#
# The link replaces the installPath Claude Code recorded rather than a fixed
# path, because that directory is named after the installed version and moves
# with it. The record is read and never written: Claude Code stays the only
# writer of its own state, and this only redirects where the payload is read
# from.
#
# The checkout is a source repo and not a package. Everything the plugin loads —
# skills/, agents/, templates/ — is copied verbatim into a package, so the layout
# already matches; the one missing piece is .claude-plugin/plugin.json, which
# scripts/lib/plugin-package.mjs builds and .gitignore keeps out of the repo.
# Without that file Claude Code sees no plugin at all, so it is written here the
# same way the packager builds it: packaging/plugin.common.json under
# packaging/claude.json.
#
# `/plugin update spec-flow` would download over the link. autoUpdates is off in
# claude/settings.json, so that only happens on request.
#
# Dropbox may not have synced on a new machine, and the plugin has to be
# installed through Claude Code before there is an installPath to redirect, so
# either gap is a note rather than a failure.
spec_flow_src="$HOME/Dropbox/andrew/skylight/code/spec-flow"

printf '\nspec-flow plugin -> ~/%s:\n' "${spec_flow_src#"$HOME"/}"

# Prints the installPath of the user-scope install, or nothing if the plugin has
# never been installed.
spec_flow_dst="$(python3 - "$HOME/.claude/plugins/installed_plugins.json" <<'PY'
import json, os, sys

path = sys.argv[1]
doc = json.load(open(path)) if os.path.exists(path) else {}
for install in doc.get("plugins", {}).get("spec-flow@skylight", []):
    print(install.get("installPath", ""))
    break
PY
)"

if [ ! -d "$spec_flow_src" ]; then
  printf '  skipped   nothing at %s\n' "$spec_flow_src"
  printf '  skipped   Dropbox may not have synced yet. Rerun install once it has.\n'
elif [ -z "$spec_flow_dst" ]; then
  printf '  skipped   not installed; add it in Claude Code with /plugin first\n'
else
  # Prints "ok" or "write". The manifest is derived, so it is rewritten whenever
  # the packaging files move rather than only when it is absent.
  manifest_state="$(python3 - "$spec_flow_src" "$dry_run" <<'PY'
import json, os, sys

repo, dry_run = sys.argv[1], sys.argv[2] == "true"


def read(*parts):
    return json.load(open(os.path.join(repo, *parts)))


# Mirrors plugin-package.mjs: the common metadata, the Claude overlay on top,
# and its own version.
want = json.dumps({**read("packaging", "plugin.common.json"), **read("packaging", "claude.json")}, indent=2) + "\n"
path = os.path.join(repo, ".claude-plugin", "plugin.json")

if os.path.exists(path) and open(path).read() == want:
    print("ok")
else:
    if not dry_run:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as handle:
            handle.write(want)
    print("write")
PY
)"

  if [ "$manifest_state" = ok ]; then
    printf '  ok        .claude-plugin/plugin.json\n'
  else
    printf '  write     .claude-plugin/plugin.json (gitignored in that repo)\n'
    changed=$((changed + 1))
  fi

  label="${spec_flow_dst#"$HOME"/}"
  if [ -L "$spec_flow_dst" ] && [ "$(readlink -- "$spec_flow_dst")" = "$spec_flow_src" ]; then
    printf '  ok        ~/%s\n' "$label"
  else
    if [ -L "$spec_flow_dst" ]; then
      printf '  relink    ~/%s (was -> %s)\n' "$label" "$(readlink -- "$spec_flow_dst")"
      run rm -- "$spec_flow_dst"
    elif [ -e "$spec_flow_dst" ]; then
      # The downloaded copy is kept: it is the only way back if the checkout is
      # mid-rewrite and the plugin has to load anyway.
      backup="$spec_flow_dst.pre-dotfiles.$(date +%Y%m%d%H%M%S)"
      printf '  BACKUP    ~/%s is the downloaded copy -> %s\n' "$label" "$(basename -- "$backup")"
      run mv -- "$spec_flow_dst" "$backup"
    else
      printf '  link      ~/%s\n' "$label"
      run mkdir -p -- "$(dirname -- "$spec_flow_dst")"
    fi
    run ln -s -- "$spec_flow_src" "$spec_flow_dst"
    changed=$((changed + 1))
  fi
fi

# The skills and subagents I write live in the buddy repo, not here. That repo is
# their home and it ships its own installer, so this repo records only that a
# machine needs them wired in. Calling buddy's installer keeps one source of
# truth for the wiring. A second copy of that logic here would drift, and drift
# is invisible in this particular place: a personal skill in ~/.claude/skills
# silently wins over a plugin skill of the same name, so a stale link goes
# unnoticed until the behaviour is wrong.
#
# Dropbox may not have synced on a new machine, so a missing buddy is a note
# rather than a failure. Rerun this script once it lands.
buddy_install="$HOME/Dropbox/andrew/code/buddy/install.sh"

printf '\n'
if [ -x "$buddy_install" ]; then
  if [ "$dry_run" = true ]; then
    "$buddy_install" --dry-run
  else
    "$buddy_install"
  fi
elif [ -e "$buddy_install" ]; then
  printf 'buddy: %s is not executable; skipped\n' "$buddy_install"
else
  printf 'buddy: nothing at %s; skipped\n' "$buddy_install"
  printf 'buddy: Dropbox may not have synced yet. Rerun install once it has.\n'
fi

if [ "$dry_run" = true ]; then
  printf '\n%s change(s) to make in this repo; nothing written.\n' "$changed"
  exit 0
fi

printf '\n%s change(s) made in this repo.\n' "$changed"

if [ ${#drifted[@]} -gt 0 ]; then
  printf '\nThese had their own version, kept as *.pre-dotfiles.*:\n'
  for label in "${drifted[@]}"; do
    printf '  %s\n' "$label"
  done
  printf 'Diff each one and fold anything worth keeping into the repo.\n'
fi

cat <<'NEXT'

Not handled here — the rest of a new machine:
  brew bundle --file ~/dotfiles/Brewfile   install the packages
  tfenv install && tfenv use <version>     terraform, into ~/.local/share/tfenv
  exec zsh                                 pick up .zshenv and .zshrc

Permissions macOS only grants by hand:
  Karabiner-Elements                       approve its driver extension, then
                                           grant Input Monitoring
  Hammerspoon                              grant Accessibility, then enable
                                           "Launch at login" in its preferences
NEXT
