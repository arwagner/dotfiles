#!/usr/bin/env python3
"""Play a random Spotify playlist.

Usage:
  spotify-random        # pick one of INCLUDE's playlists at random and play it
  spotify-random list   # show which of your playlists INCLUDE matches
  spotify-random auth   # one-time browser authorization (adds playback control)

Standalone: talks to the Spotify Web API directly, with no other tools or
libraries involved. Credentials live in the macOS Keychain under
spotify-random-client-id/-client-secret/-refresh-token; the first run prompts
for the client id and secret from a Spotify app registration
(https://developer.spotify.com/dashboard) that lists
http://127.0.0.1:8888/callback as a redirect URI.
"""
import base64
import getpass
import http.server
import json
import os
import random
import subprocess
import sys
import threading
import urllib.error
import urllib.parse
import urllib.request

REDIRECT_URI = "http://127.0.0.1:8888/callback"
SCOPES = ("playlist-read-private playlist-read-collaborative "
          "user-read-currently-playing user-read-playback-state "
          "user-modify-playback-state")
SERVICE_PREFIX = "spotify-random-"

# Playlists to draw from, matched by name prefix so new volumes are picked up
# automatically. Everything else (Christmas, the D&D sets, karaoke, lofi) is
# left out of the pool.
INCLUDE = (
    "Pop Odds & Ends",
    "Pop Hits & Soundtracks",
    "Pop Covers",
    "Pop Music",
    "Celtic Woman",
    "Christian",
)


def _keychain_get(key: str) -> str | None:
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-a", os.environ["USER"],
             "-s", SERVICE_PREFIX + key, "-w"],
            capture_output=True, text=True, check=True)
        return out.stdout.strip()
    except subprocess.CalledProcessError:
        return None


def _keychain_set(key: str, value: str) -> None:
    subprocess.run(
        ["security", "add-generic-password", "-a", os.environ["USER"],
         "-s", SERVICE_PREFIX + key, "-w", value, "-U"],
        check=True, capture_output=True)


def _keychain_prompt(key: str, prompt: str) -> str:
    v = _keychain_get(key)
    if v:
        return v
    if not sys.stdin.isatty():
        sys.exit(f"No {key} in keychain ({SERVICE_PREFIX}{key}).")
    print(f"Register an app at https://developer.spotify.com/dashboard with "
          f"redirect URI {REDIRECT_URI}.")
    v = getpass.getpass(prompt).strip()
    if not v:
        sys.exit("Nothing entered.")
    _keychain_set(key, v)
    return v


def _client_id() -> str:
    return _keychain_prompt("client-id", "Spotify client id: ")


def _client_secret() -> str:
    return _keychain_prompt("client-secret", "Spotify client secret: ")


def _basic_auth_header() -> str:
    raw = f"{_client_id()}:{_client_secret()}".encode()
    return "Basic " + base64.b64encode(raw).decode()


def _post_form(url: str, data: dict, headers: dict) -> dict:
    body = urllib.parse.urlencode(data).encode()
    req = urllib.request.Request(url, data=body, headers=headers, method="POST")
    with urllib.request.urlopen(req) as resp:
        return json.loads(resp.read().decode())


def _get(url: str, token: str) -> dict:
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(req) as resp:
        raw = resp.read()
        return json.loads(raw.decode()) if raw else {}


def _put(url: str, token: str, payload: dict) -> int:
    body = json.dumps(payload).encode() if payload else b""
    req = urllib.request.Request(url, data=body, method="PUT", headers={
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
    })
    try:
        with urllib.request.urlopen(req) as resp:
            return resp.status
    except urllib.error.HTTPError as e:
        return e.code


def _access_token() -> str:
    refresh = _keychain_get("refresh-token")
    if not refresh:
        sys.exit("Not authorized yet. Run: spotify-random auth")
    data = _post_form(
        "https://accounts.spotify.com/api/token",
        {"grant_type": "refresh_token", "refresh_token": refresh},
        {"Authorization": _basic_auth_header(),
         "Content-Type": "application/x-www-form-urlencoded"},
    )
    if data.get("refresh_token"):
        _keychain_set("refresh-token", data["refresh_token"])
    return data["access_token"]


def cmd_auth():
    params = {
        "client_id": _client_id(),
        "response_type": "code",
        "redirect_uri": REDIRECT_URI,
        "scope": SCOPES,
    }
    auth_url = "https://accounts.spotify.com/authorize?" + urllib.parse.urlencode(params)

    code_holder = {}

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            qs = urllib.parse.urlparse(self.path).query
            parsed = urllib.parse.parse_qs(qs)
            code_holder["code"] = parsed.get("code", [None])[0]
            code_holder["error"] = parsed.get("error", [None])[0]
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            msg = "Authorized. You can close this tab." if code_holder.get("code") \
                else f"Error: {code_holder.get('error')}"
            self.wfile.write(msg.encode())

        def log_message(self, *a):
            pass

    server = http.server.HTTPServer(("127.0.0.1", 8888), Handler)
    t = threading.Thread(target=server.handle_request, daemon=True)
    t.start()

    subprocess.run(["open", auth_url])
    print("Waiting for authorization in the browser...")
    t.join(timeout=180)

    if not code_holder.get("code"):
        sys.exit(f"Authorization failed or timed out: {code_holder.get('error')}")

    data = _post_form(
        "https://accounts.spotify.com/api/token",
        {"grant_type": "authorization_code", "code": code_holder["code"],
         "redirect_uri": REDIRECT_URI},
        {"Authorization": _basic_auth_header(),
         "Content-Type": "application/x-www-form-urlencoded"},
    )
    if "refresh_token" not in data:
        sys.exit(f"No refresh token in response: {data}")
    _keychain_set("refresh-token", data["refresh_token"])
    print("Authorized. Refresh token stored in the keychain.")


def _all_playlists(token: str) -> list[dict]:
    playlists = []
    url = "https://api.spotify.com/v1/me/playlists?limit=50"
    while url:
        data = _get(url, token)
        playlists.extend(data.get("items", []))
        url = data.get("next")
    return playlists


def _included(playlists: list[dict]) -> list[dict]:
    return [p for p in playlists
            if p and p.get("name", "").startswith(INCLUDE)]


def _active_device_id(token: str) -> str | None:
    data = _get("https://api.spotify.com/v1/me/player/devices", token)
    devices = data.get("devices", [])
    for d in devices:
        if d.get("is_active"):
            return d["id"]
    return devices[0]["id"] if devices else None


def cmd_list():
    playlists = _included(_all_playlists(_access_token()))
    for pl in sorted(playlists, key=lambda p: p["name"]):
        print(pl["name"])
    print(f"\n{len(playlists)} playlists in the pool.")


def cmd_random():
    token = _access_token()
    playlists = _included(_all_playlists(token))
    if not playlists:
        sys.exit("No playlists matched INCLUDE.")
    pl = random.choice(playlists)

    status = _put("https://api.spotify.com/v1/me/player/play", token,
                   {"context_uri": pl["uri"]})
    if status == 404:
        device_id = _active_device_id(token)
        if not device_id:
            sys.exit("No Spotify device found. Open Spotify somewhere first.")
        status = _put(f"https://api.spotify.com/v1/me/player/play?device_id={device_id}",
                       token, {"context_uri": pl["uri"]})
    if status not in (200, 204):
        sys.exit(f"Spotify returned status {status} trying to start playback.")

    print(f"Now playing: {pl['name']}")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "random"
    if cmd == "auth":
        cmd_auth()
    elif cmd == "list":
        cmd_list()
    elif cmd == "random":
        cmd_random()
    else:
        sys.exit(__doc__)
